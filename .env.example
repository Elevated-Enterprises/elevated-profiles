# Discord OAuth Application
# Create your app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your-discord-client-secret-here
DISCORD_REDIRECT_URI=https://profiles.yourcommunity.io/auth/callback

# Your Discord server (guild) ID — only members of this server can log in
DISCORD_GUILD_ID=987654321098765432

# JWT signing secret — must be at least 32 characters, keep this secret
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Academy content repository (Obsidian vault, public GitHub repo)
# Leave empty to disable the Academy feature
ACADEMY_REPO_URL=https://github.com/your-org/your-academy-repo
